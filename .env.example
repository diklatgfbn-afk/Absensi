# Supabase PostgreSQL Connection String (required)
# Get from Supabase Dashboard → Project Settings → Database → Connection String (URI)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:port/postgres

# Session cookie encryption key (required on production)
SESSION_SECRET=your-random-session-secret-key-here-change-in-production

# CORS origin (optional, defaults to *)
CORS_ORIGIN=*

# Node environment
NODE_ENV=production
